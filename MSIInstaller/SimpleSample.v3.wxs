<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="SimpleSample"
      Language="1033"
      Version="<PACKAGEVERSION>"
      Manufacturer="HyperHippoDemo"
      UpgradeCode="{B11A5A8C-2F7E-43E0-A8D3-1A41AE3396D4}">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate CompressionLevel="high" />

    <Property Id="ARPCOMMENTS" Value="Unity command-line build output for SimpleSample" />
    <Property Id="ARPCONTACT" Value="HyperHippoDemo" />
    <Property Id="ARPURLINFOABOUT" Value="https://qnflegacy.ca" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="SimpleSample" />
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="SimpleSample" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>
  </Product>
</Wix>
