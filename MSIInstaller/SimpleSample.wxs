<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="SimpleSample"
      Manufacturer="HyperHippoDemo"
      Version="$(var.PACKAGEVERSION)"
      UpgradeCode="{B11A5A8C-2F7E-43E0-A8D3-1A41AE3396D4}"
      Scope="perMachine"
      Language="1033">

    <MediaTemplate CompressionLevel="high" />

    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes" />
    <Property Id="LAUNCHAPPONEXIT" Value="1" Secure="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SimpleSample" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="SimpleSample" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <ComponentGroup Id="AppComponents">
      <Files Include="$(var.RELEASEPATH)\**\*" />

      <Component Directory="INSTALLFOLDER" Id="MainExecutableComponent">
        <File Id="SimpleSampleExe" Source="$(var.RELEASEPATH)\SimpleSample.exe" KeyPath="yes" />
      </Component>

      <Component Directory="DesktopFolder" Id="DesktopShortcutComponent" Condition="CREATE_DESKTOP_SHORTCUT = 1">
        <File Id="SimpleSampleDesktopShortcutFile" Source="$(var.RELEASEPATH)\SimpleSample.exe" KeyPath="yes">
          <Shortcut
              Id="DesktopShortcut"
              Name="SimpleSample"
              Directory="DesktopFolder"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="no" />
        </File>
      </Component>
    </ComponentGroup>

    <CustomAction Id="LaunchApplication"
                  FileRef="SimpleSampleExe"
                  ExeCommand=""
                  Return="asyncNoWait"
                  Impersonate="no" />

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication" After="InstallFinalize" Condition="(LAUNCHAPPONEXIT = 1) AND (NOT Installed)" />
    </InstallExecuteSequence>

    <Property Id="ARPCOMMENTS" Value="Unity command-line build output for SimpleSample" />
    <Property Id="ARPCONTACT" Value="HyperHippoDemo" />
    <Property Id="ARPURLINFOABOUT" Value="https://qnflegacy.ca" />
  </Package>
</Wix>
